{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebSocket X v2",
  "version": "0.2.0",
  "identifier": "dev.wsx.frontend",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WebSocket X v2 \u2014 Autoplay Console",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/app-icon.png"
    ]
  }
}